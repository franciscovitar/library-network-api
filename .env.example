# Example only. Compose sets the correct in-container URL automatically.
DATABASE_URL=postgresql+psycopg://library:local_demo_only@db:5432/library_network

# Historical V1 endpoint access is DISABLED by default. For disposable local
# developer containers only (never copy these flags into a hosted environment):
# LIBRARY_RUNTIME_MODE=local
# LIBRARY_ENABLE_UNSAFE_V1=1
#
# /api/v2 staff identity: deliberately NOT configured here.
# A future trusted BFF must issue short-lived RS256 API tokens after login.
# The API gets only the public RSA JWKS, never any private signing material.
# LIBRARY_JWT_ISSUER=https://identity.example.test
# LIBRARY_JWT_AUDIENCE=library-network-api
# LIBRARY_JWKS_JSON={"keys":[{"kty":"RSA","kid":"...","n":"...","e":"AQAB"}]}
