# Never commit real credentials. No default secret or token is included here.
# Required for OAuth login to function (GitHub OAuth App):
# AUTH_SECRET=<server-only random secret>
# AUTH_GITHUB_ID=<OAuth client ID>
# AUTH_GITHUB_SECRET=<OAuth client secret>
# AUTH_URL=http://localhost:3000
#
# Server-to-server service token. The RSA private key belongs to the BFF only.
# The FastAPI backend receives the corresponding PUBLIC JWKS.
# LIBRARY_API_URL=http://127.0.0.1:8000
# LIBRARY_API_SIGNING_KEY_PKCS8=<PEM PKCS8 private key with escaped newline characters>
# LIBRARY_API_SIGNING_KID=<matching RSA key ID in backend JWKS>
# LIBRARY_JWT_ISSUER=https://library-bff.example.test
# LIBRARY_JWT_AUDIENCE=library-network-api
#
# The FastAPI DB staff_users.subject must match github:<immutable provider id>,
# with a branch grant provisioned by an authorized operator.
